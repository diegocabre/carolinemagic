# ==============================================================================
# CAROLINE MAGIC — VARIABLES DE ENTORNO (plantilla SIN valores)
# ==============================================================================
# Copia este archivo a .env.local para desarrollo y configura las mismas
# variables en Vercel → Settings → Environment Variables (Production y Preview).
# Nunca subas .env.local ni valores reales al repositorio.

# --- WhatsApp -----------------------------------------------------------------
# Solo dígitos (código de país + número), sin "+" ni espacios.
# Si se omite, se usa el número oficial definido en src/config/whatsapp.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Panel admin --------------------------------------------------------------
# Correo con el que Caroline inicia sesión.
ADMIN_EMAIL=
# Hash scrypt de la clave. Genéralo con: npm run admin:hash
ADMIN_PASSWORD_HASH=
# DEPRECADO: clave en texto plano. Solo como compatibilidad temporal; bórrala
# en cuanto exista ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=

# --- Vercel Blob (imágenes de la sincronicidad del día) -----------------------
# Lo crea Vercel al conectar el store de Blob al proyecto.
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (rate limit, sesiones admin, registro de solicitudes) -------
# Obligatorio en producción y preview: sin estas variables el login admin se
# deshabilita (falla segura). En `npm run dev` se
# usa un almacén en memoria con un aviso.
# También se aceptan KV_REST_API_URL / KV_REST_API_TOKEN (nombres que crea la
# integración de Upstash en Vercel). La base puede compartirse con otro
# proyecto: todas las claves de este sitio llevan el prefijo "cm:".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
